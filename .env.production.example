# ============================================================
# almo-erp — variáveis de PRODUÇÃO (Dokploy)
#
# Cadastradas em Dokploy → Application → Environment.
# Este arquivo é o seu rascunho/checklist — NUNCA commite valores reais.
# ============================================================

# ---------- Banco ----------
# A aplicação fala com o Postgres do Dokploy pelo NOME DO SERVIÇO, na rede
# interna do Docker (não é IP). Confira o nome do serviço no próprio Dokploy.
DATABASE_URL="postgresql://almo:<senha-forte>@<servico-postgres>:5432/almo_erp?schema=public"

# ---------- Aplicação ----------
NEXT_PUBLIC_APP_NAME="almo-erp"
NEXT_PUBLIC_APP_URL="https://colegiobatista.josetilabs.com"

# ---------- Autenticação ----------
AUTH_SECRET="<openssl rand -base64 32>"
AUTH_URL="https://colegiobatista.josetilabs.com"
AUTH_TRUST_HOST="true"

# Google — vazio = botão desligado. O acesso é pelo login local (e-mail + senha).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_ALLOWED_DOMAINS=""

# ---------- Anexos ----------
# Precisa bater com o volume montado no Dokploy (ver docs/DEPLOY.md).
UPLOAD_DIR="/data/uploads"

# ---------- Seed (rodado UMA vez pelo Run Command — não pela app) ----------
SEED_ADMIN_EMAIL="jose-guilherme93@hotmail.com"
SEED_ADMIN_NAME="Administrador da Matriz"
SEED_ADMIN_PASSWORD="<senha-forte>"
SEED_ADMIN_RESET_PASSWORD="false"

# ---------- Regras de negócio (opcionais) ----------
SLA_APPROVAL_HOURS="24"
STOCK_BELOW_MIN_DEDUP_DAYS="7"
MATRIX_APPROVAL_THRESHOLD="1000.00"

# ---------- Testes: SEMPRE desligado em produção ----------
E2E_AUTH_BYPASS="false"
