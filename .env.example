# ============================================================
# almo-erp — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env`.
# ============================================================

# ---------- Aplicação ----------
NEXT_PUBLIC_APP_NAME="almo-erp"
# URL pública da aplicação (usada em links e no callback do OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Banco de dados (FASE 00) ----------
# Usadas pelo docker-compose.yml
POSTGRES_USER="almo"
POSTGRES_PASSWORD="almo_dev_password"
POSTGRES_DB="almo_erp"
POSTGRES_PORT="5432"

# Conexão usada pelo Prisma (FASE 00 / FASE 01)
DATABASE_URL="postgresql://almo:almo_dev_password@localhost:5432/almo_erp?schema=public"

# ---------- Autenticação Google (FASE 02) ----------
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Domínios corporativos permitidos, separados por vírgula (FASE 02).
# Somam-se às EmailPolicy cadastradas no banco.
AUTH_ALLOWED_DOMAINS=""

# ---------- Testes end-to-end ----------
# Habilita um provider de credenciais que dispensa o Google nos testes
# automatizados. NUNCA ligue em produção: a aplicação recusa subir com esta
# combinação, mas mantenha desligado por padrão.
E2E_AUTH_BYPASS="false"

# ---------- Seed (FASE 01) ----------
# E-mail do administrador da matriz criado pelo seed. Precisa ser um
# e-mail do domínio corporativo para conseguir logar na FASE 02.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="Administrador da Matriz"

# ---------- Regras de negócio (FASE 09 / FASE 13) ----------
# Horas antes de uma solicitação ser marcada como "SLA em risco"
SLA_APPROVAL_HOURS="24"
# Janela de deduplicação do alerta de estoque abaixo do mínimo, em dias
STOCK_BELOW_MIN_DEDUP_DAYS="7"
# Valor (BRL) a partir do qual a solicitação exige aprovação da matriz
MATRIX_APPROVAL_THRESHOLD="1000.00"

# ---------- E-mail (FASE 13, opcional) ----------
# Só preencha se houver provedor SMTP definido
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
