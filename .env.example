# ============================================================
# almo-erp — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env`.
# ============================================================

# ---------- Aplicação ----------
NEXT_PUBLIC_APP_NAME="almo-erp"
# URL pública da aplicação (usada em links e no callback do OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ---------- Banco de dados (FASE 00) ----------
# Usadas pelo docker-compose.yml
POSTGRES_USER="almo"
POSTGRES_PASSWORD="almo_dev_password"
POSTGRES_DB="almo_erp"
POSTGRES_PORT="5432"

# Conexão usada pelo Prisma (FASE 00 / FASE 01)
DATABASE_URL="postgresql://almo:almo_dev_password@localhost:5432/almo_erp?schema=public"

# Opcional: conexão direta, sem pooler (Neon). Em dev o Postgres local já é
# direto, então normalmente fica vazio — a app e o CLI usam o DATABASE_URL.
# DIRECT_URL=""

# ---------- Autenticação Google (FASE 02) ----------
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Domínios corporativos permitidos, separados por vírgula (FASE 02).
# Somam-se às EmailPolicy cadastradas no banco.
AUTH_ALLOWED_DOMAINS=""

# ---------- Google Drive (exportação de relatórios) ----------
# Client ID público (OAuth 2.0 Web) usado no navegador para pedir acesso ao
# Drive com o escopo mínimo `drive.file`. Normalmente é o mesmo AUTH_GOOGLE_ID.
# Pré-requisito no Google Cloud Console: habilitar a Google Drive API e
# adicionar o escopo `https://www.googleapis.com/auth/drive.file` à tela de
# consentimento OAuth. Sem isso, o botão "Enviar ao Google Drive" fica desabilitado.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ---------- Testes end-to-end ----------
# Habilita um provider de credenciais que dispensa o Google. Serve para os
# testes automatizados e para explorar o sistema localmente antes de configurar
# o Google. NUNCA ligue em produção: a aplicação recusa subir com esta
# combinação, mas mantenha desligado por padrão.
E2E_AUTH_BYPASS="false"

# ---------- Seed (FASE 01) ----------
# E-mail do administrador da matriz criado pelo seed. Com login local
# (e-mail + senha) pode ser qualquer domínio; com login Google precisa ser um
# e-mail corporativo autorizado.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="Administrador da Matriz"

# ---------- Login local (e-mail + senha) ----------
# Senha inicial do administrador para o login local. Sem ela, o admin só
# entraria por Google. Mínimo de 8 caracteres. O valor abaixo é de
# DESENVOLVIMENTO — em produção use uma senha forte no .env.production.
SEED_ADMIN_PASSWORD="dev-senha-1234"
# "true" reescreve a senha do admin a cada seed (use para recuperar acesso).
SEED_ADMIN_RESET_PASSWORD="false"

# ---------- Regras de negócio (FASE 09 / FASE 13) ----------
# Horas antes de uma solicitação ser marcada como "SLA em risco"
SLA_APPROVAL_HOURS="24"
# Janela de deduplicação do alerta de estoque abaixo do mínimo, em dias
STOCK_BELOW_MIN_DEDUP_DAYS="7"
# Valor (BRL) a partir do qual a solicitação exige aprovação da matriz
MATRIX_APPROVAL_THRESHOLD="1000.00"
# Base da API pública de consulta de CNPJ (padrão: BrasilAPI)
# CNPJ_API_URL="https://brasilapi.com.br/api/cnpj/v1"

# SHA do commit injetado no build (opcional; no Docker vem como --build-arg GIT_SHA)
# GIT_SHA=""

# ---------- E-mail (FASE 13, opcional) ----------
# Só preencha se houver provedor SMTP definido
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
